MSSQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=.\SQLEXPRESS;DATABASE=Madhushala;UID=snapkey_reports;PWD=replace-me;Encrypt=no;TrustServerCertificate=yes;
CONNECTOR_SECRET=replace-with-a-long-random-secret
CONNECTOR_MAX_DAYS=90
CONNECTOR_MAX_POINTS=50
CONNECTOR_QUERY_TIMEOUT_SECONDS=8

# Railway PostgreSQL public URL, used only by the local synchronization worker.
REPORT_SYNC_DATABASE_URL=postgresql://user:password@host:port/railway
REPORT_TENANT_ID=replace-with-companycode
