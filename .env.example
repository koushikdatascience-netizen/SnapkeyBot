APP_ENV=development
DATABASE_URL=postgresql+asyncpg://snapkey:snapkey@localhost:5432/snapkey
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TASK_ALWAYS_EAGER=false
# Choose: deterministic, groq, openai, or openrouter
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_STEPS=6
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Snapkey Assistant

# Human-assisted demo mode. Requires Telegram webhook configuration.
CONCIERGE_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=15000000

# ElevenLabs streamed voice responses.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_LANGUAGE_CODE=hi
TTS_MAX_CHARACTERS=5000

# Fully local, no-usage-bill voice runtime. Install with: pip install -e ".[local-voice]"
LOCAL_VOICE_ENABLED=false
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_LANGUAGE=hi
# sapi works offline on Windows. Use piper for a better custom Hindi/English voice.
LOCAL_TTS_PROVIDER=sapi
LOCAL_TTS_PIPER_EXECUTABLE=
LOCAL_TTS_PIPER_MODEL=
LOCAL_TTS_SAPI_VOICE=
LOCAL_VOICE_SILENCE_MS=650
LOCAL_VOICE_MIN_SPEECH_MS=350

# Safe Windows desktop control for the existing Madhushala EXE.
MADHUSHALA_EXE_PATH=C:\Path\To\Madhushala Ultimate.exe
MADHUSHALA_PROCESS_NAME=Madhushala Ultimate
# Additional explicitly allowed apps:
# {"chrome":{"exe":"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe","process":"chrome"},"notepad":{"exe":"C:\\Windows\\System32\\notepad.exe","process":"notepad"}}
DESKTOP_APPS_JSON=
# Demo/local meetings when Google Calendar is not connected:
# [{"time":"10:30 AM","title":"Supplier review"},{"time":"6:30 PM","title":"Meeting at Prayag"}]
LOCAL_DEMO_MEETINGS_JSON=

# Optional comma-separated frontend origins when hosting the UI separately.
CORS_ORIGINS=
PUBLIC_URL=

# Google Cloud OAuth web application and YouTube Data API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Browserbase hosted Chrome.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=ap-southeast-1

# Cloud reporting database. On Railway, use the existing PostgreSQL service:
# REPORT_DATABASE_URL=${{Postgres.DATABASE_URL}}
REPORT_DATABASE_URL=
# Preferred for a shop-local Microsoft SQL Server connector:
REPORT_CONNECTOR_URL=
REPORT_CONNECTOR_SECRET=
# Single-shop fallback:
REPORT_TENANT_ID=
# Multi-shop production mapping, for example {"owner@example.com":"shop-001"}:
REPORT_TENANT_MAP_JSON=
REPORT_MAX_DAYS=90
REPORT_MAX_POINTS=50
REPORT_QUERY_TIMEOUT_SECONDS=8

# Optional HTTPS MP4/WebM demo feeds. Comma-separated, maximum three.
MONITORING_CAMERA_URLS=
MONITORING_SCREEN_URL=

# Protects the private /director remote-control page.
DEMO_OPERATOR_SECRET=replace-with-a-long-random-meeting-secret
