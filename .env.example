APP_ENV=development
DATABASE_URL=postgresql+asyncpg://snapkey:snapkey@localhost:5432/snapkey
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TASK_ALWAYS_EAGER=false
# Choose: deterministic, groq, openai, or openrouter
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_STEPS=6
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Snapkey Assistant

# Human-assisted demo mode. Requires Telegram webhook configuration.
CONCIERGE_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
